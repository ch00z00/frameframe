---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  work: string;
  englishTitle: string;
  subtitle: string;
  tone: 'cold' | 'warm';
  image?: ImageMetadata;
}

const { work, englishTitle, subtitle, tone, image } = Astro.props;
---

<!--
  This is the morph target for the homepage card: src/pages/index.astro
  tags the clicked card's .frame-image / .beat-work / .beat-subtitle with
  matching view-transition-name values (via inline style, at click time,
  since the card that gets clicked is whichever one the virtual carousel
  currently has centered — it isn't known ahead of time) right before the
  native navigation fires. These three names are set as static inline
  styles here because this page only ever has one of each.
-->
<header class="article-hero" data-tone={tone}>
  <div class="hero-photo" style="view-transition-name: hero-photo">
    {image ? (
      <Image src={image} alt="" role="presentation" class="hero-photo-img" widths={[640, 1024, 1600, 2000]} sizes="100vw" />
    ) : (
      <div class="hero-field" aria-hidden="true"></div>
    )}
    <div class="hero-vignette" aria-hidden="true"></div>
    <div class="hero-scrim" aria-hidden="true"></div>
  </div>
  <div class="hero-text">
    <p class="hero-work" style="view-transition-name: hero-work">
      {englishTitle !== work && <span class="hero-work-en">{englishTitle}</span>}
      <span class="hero-work-jp">{work}</span>
    </p>
    <h1 class="hero-subtitle" style="view-transition-name: hero-subtitle">{subtitle}</h1>
  </div>
  <div class="hero-scroll-cue" aria-hidden="true"><span></span>SCROLL</div>
</header>

<style>
  .article-hero {
    position: relative;
    /* Above 0: inception.mdx's .depth-map-anchor is position:fixed; inset:0
       with z-index:0 so it can stay visible behind the article body (which
       sits at z-index:1) for the whole scroll — but "fixed" means it also
       covers this hero at the top of the page unless the hero outranks it.
       z-index alone isn't enough here: position:fixed elements can get
       promoted to their own top-level compositor layer that paints above
       ordinary (non-promoted) siblings regardless of DOM z-index, so the
       hero needs the same promotion (via transform) to reliably win. */
    z-index: 1;
    transform: translateZ(0);
    height: 92svh;
    min-height: 460px;
    overflow: hidden;
    isolation: isolate;
    color: #fff;
  }
  .hero-photo {
    position: absolute;
    inset: 0;
  }
  .hero-photo-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero-field {
    position: absolute;
    inset: -6%;
    background-image:
      radial-gradient(120% 140% at 14% -8%, var(--field-hi), transparent 58%),
      linear-gradient(155deg, var(--field-a) 0%, var(--field-b) 60%, var(--field-c) 100%);
  }
  [data-tone='cold'] .hero-field {
    --field-hi: color-mix(in srgb, var(--cold-deep) 55%, transparent);
    --field-a: var(--cold);
    --field-b: color-mix(in srgb, var(--cold) 55%, var(--ink) 45%);
    --field-c: color-mix(in srgb, var(--cold) 18%, black 58%);
  }
  [data-tone='warm'] .hero-field {
    --field-hi: color-mix(in srgb, var(--warm-deep) 55%, transparent);
    --field-a: var(--warm);
    --field-b: color-mix(in srgb, var(--warm) 55%, var(--ink) 45%);
    --field-c: color-mix(in srgb, var(--warm) 16%, black 58%);
  }
  .hero-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 120% at 50% 55%, transparent 45%, rgba(0, 0, 0, 0.5) 100%);
  }
  .hero-scrim {
    position: absolute;
    inset: auto 0 0 0;
    height: 56%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.72), transparent);
  }
  .hero-text {
    position: absolute;
    inset: auto clamp(20px, 5vw, 60px) clamp(48px, 7vw, 76px) clamp(20px, 5vw, 60px);
  }
  .hero-work {
    margin: 0 0 clamp(10px, 1.6vw, 16px);
    line-height: 1.5;
  }
  .hero-work-en {
    display: block;
    font-family: var(--mono);
    font-style: italic;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.62);
  }
  .hero-work-jp {
    display: block;
    font-family: var(--serif-display);
    font-size: 1rem;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.92);
  }
  .hero-subtitle {
    position: relative;
    margin: 0;
    padding-left: clamp(16px, 2.2vw, 22px);
    font-family: var(--serif-display);
    font-optical-sizing: auto;
    font-weight: 460;
    font-size: clamp(2.2rem, 6vw, 4.6rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    text-wrap: balance;
    max-width: 24ch;
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.45);
  }
  .hero-subtitle::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.08em;
    bottom: 0.12em;
    width: 4px;
  }
  [data-tone='cold'] .hero-subtitle::before {
    background: #9fd0e6;
  }
  [data-tone='warm'] .hero-subtitle::before {
    background: #f4c778;
  }
  .hero-scroll-cue {
    position: absolute;
    right: clamp(20px, 5vw, 60px);
    bottom: clamp(48px, 7vw, 76px);
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: 0.64rem;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.7);
  }
  .hero-scroll-cue span {
    width: 1px;
    height: 22px;
    background: currentColor;
    animation: hero-scroll-cue-pulse 1.8s ease-in-out infinite;
  }
  @keyframes hero-scroll-cue-pulse {
    0%, 100% { transform: scaleY(1); opacity: 0.5; }
    50% { transform: scaleY(0.4); opacity: 1; }
  }

  @media (max-width: 640px) {
    .article-hero { height: 86svh; }
    .hero-scroll-cue { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-cue span { animation: none; }
  }
</style>
