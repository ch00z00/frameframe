---
// Two-column chapter layout: a flexible prose column (default slot, wrapped
// in `.chapter` with its own h2/p typography) paired with a narrower margin
// aside (named `margin` slot). Ported from the `.chapter-row` /
// `.chapter-margin` pattern in docs/artifacts/detail-mock-2001-odyssey.html.
---

<section class="chapter-row">
  <div class="chapter">
    <slot />
  </div>
  <aside class="chapter-margin">
    <slot name="margin" />
  </aside>
</section>

<style>
  .chapter-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 30em);
    column-gap: clamp(3rem, 7vw, 7.5rem);
    align-items: start;
    margin-top: clamp(2.2rem, 5vh, 3.2rem);
  }
  .chapter-margin {
    max-width: 26em;
    padding-top: 0.3rem;
    padding-left: clamp(1.4rem, 2.4vw, 2rem);
    border-left: 1px solid var(--rule);
  }

  @media (max-width: 880px) {
    .chapter-row {
      grid-template-columns: 1fr;
      row-gap: 1.8rem;
    }
    .chapter-margin {
      max-width: 44em;
      border-left: none;
      padding-left: 0;
      padding-top: 1.5rem;
      border-top: 1px solid var(--rule);
    }
  }

  .chapter :global(h2) {
    font-family: var(--serif-display);
    font-weight: 460;
    font-size: clamp(2.1rem, 5.2vw, 3.5rem);
    line-height: 1.14;
    letter-spacing: -0.01em;
    text-wrap: balance;
    margin: 0;
  }
  .chapter :global(p) {
    font-size: clamp(1.05rem, 0.95rem + 0.35vw, 1.15rem);
    line-height: 1.92;
    color: var(--paper);
    max-width: 44em;
    margin-top: clamp(1.5rem, 3vh, 2rem);
  }
  .chapter :global(p + p) {
    margin-top: 1.3em;
  }
</style>
